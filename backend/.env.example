# ─── Server ───────────────────────────────────────────────
PORT=5000

# ─── Database (MySQL) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kenyahomes
DB_USER=root
DB_PASSWORD=yourpassword

# ─── JWT ──────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
# Development:  http://localhost:5173
# Production:   https://your-admin-domain.com
FRONTEND_URL=http://localhost:5173

# ─── File Uploads ─────────────────────────────────────────
# Currently files are stored locally in /uploads.
# For production deployments (containers, serverless) use cloud storage:
#   - Cloudinary: set CLOUDINARY_URL
#   - AWS S3:     set AWS_BUCKET, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Until cloud storage is integrated, ensure /uploads is on a persistent volume.

# ─── M-Pesa (Daraja API) ──────────────────────────────────
# 1. Register at https://developer.safaricom.co.ke
# 2. Create an app — you will receive Consumer Key + Consumer Secret
# 3. For sandbox testing use shortcode 174379 and the sandbox passkey below
# 4. For production, use your actual Paybill/Till shortcode and live passkey

MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Sandbox shortcode: 174379
MPESA_SHORTCODE=174379

# Sandbox passkey (use this for testing):
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# sandbox | production
MPESA_ENV=sandbox

# Public HTTPS URL where Safaricom posts payment results.
# In development: use ngrok → ngrok http 5000 → copy the https URL
#   e.g. https://abc123.ngrok-free.app
# In production: your real domain  e.g. https://api.kenyahomes.co.ke
MPESA_CALLBACK_BASE_URL=https://your-ngrok-or-domain.com

# Shortcode that RECEIVES the money (your Paybill or Till number).
# If your initiator shortcode and receiver are the same, leave this commented out.
# MPESA_RECEIVER_SHORTCODE=your_paybill_or_till_here

# CustomerPayBillOnline (Paybill) | CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Your personal M-Pesa number — the withdrawal destination from your Paybill/Till.
# Register at a Safaricom agent or business portal to link this number to your Paybill.
# NOTE: Personal phone numbers cannot directly receive STK Push payments —
#       you need a Paybill or Till shortcode. Money lands there, you withdraw anytime.
MPESA_OWNER_PHONE=0745590824
