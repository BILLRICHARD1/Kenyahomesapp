# ─── M-Pesa (Daraja API) ──────────────────────────────────
# Get these from https://developer.safaricom.co.ke
# Use sandbox credentials for development, live credentials for production
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Paybill or Till number (your shortcode)
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa Online passkey (from Daraja portal)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# sandbox | production
MPESA_ENV=sandbox

# Public URL where Safaricom will POST the payment callback
# Must be HTTPS and publicly reachable (use ngrok in development)
# e.g. https://abc123.ngrok.io  (no trailing slash)
MPESA_CALLBACK_BASE_URL=https://your-ngrok-or-domain.com

# Shortcode that RECEIVES the money (your Paybill or Till number).
# If your initiator shortcode and receiver are the same, leave this commented out.
# MPESA_RECEIVER_SHORTCODE=your_paybill_or_till_here

# CustomerPayBillOnline (Paybill) | CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Your personal M-Pesa number — used as the withdrawal destination
# from your Paybill/Till wallet. Not used in API calls directly.
# Register at a Safaricom agent to link 0745590824 to your Paybill.
MPESA_OWNER_PHONE=0745590824
